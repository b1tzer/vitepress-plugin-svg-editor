{
  "name": "vitepress-plugin-svg-editor",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "description": "A VitePress plugin that provides interactive SVG editing capabilities directly in Markdown",
  "keywords": [
    "vitepress",
    "plugin",
    "svg",
    "editor",
    "fabricjs"
  ],
  "license": "MIT",
  "author": "b1tzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/b1tzer/vitepress-plugin-svg-editor.git"
  },
  "homepage": "https://github.com/b1tzer/vitepress-plugin-svg-editor#readme",
  "bugs": {
    "url": "https://github.com/b1tzer/vitepress-plugin-svg-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.mjs",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.cjs"
    }
  },
  "files": [
    "dist",
    "src/client",
    "src/components",
    "src/composables",
    "src/core",
    "src/utils",
    "src/plugins",
    "src/styles",
    "src/adapters",
    "src/env.d.ts"
  ],
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:visual": "playwright test tests/e2e/visual/editor-layout-stability.spec.ts --project=chromium",
    "test:render": "playwright test tests/e2e/render-regression.spec.ts --project=chromium",
    "test:perf": "playwright test tests/e2e/performance-regression.spec.ts --project=perf",
    "cls:check": "lighthouse-ci --config=./.lighthouserc.json"
  },
  "peerDependencies": {
    "fabric": ">=6.0.0 <7.0.0",
    "vitepress": ">=1.0.0 <2.0.0",
    "vue": ">=3.2.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "fabric": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "fabric": "^6.5.3",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "unbuild": "^2.0.0",
    "vite": "^5.4.14",
    "vitepress": "^1.6.3",
    "vitest": "^2.0.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.12"
  },
  "dependencies": {
    "dompurify": "^3.2.6"
  }
}
