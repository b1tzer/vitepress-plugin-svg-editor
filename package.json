{
  "name": "vitepress-plugin-svg-editor",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "A VitePress plugin that provides interactive SVG editing capabilities directly in Markdown",
  "keywords": [
    "vitepress",
    "plugin",
    "svg",
    "editor",
    "fabricjs"
  ],
  "license": "MIT",
  "author": "b1tzer",
  "main": "./dist/node/index.cjs",
  "module": "./dist/node/index.mjs",
  "types": "./dist/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/node/index.d.ts",
      "import": "./dist/node/index.mjs",
      "require": "./dist/node/index.cjs"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "import": "./src/client/index.ts"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "import": "./dist/plugins/index.mjs",
      "require": "./dist/plugins/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "**/*.vue",
    "**/*.css"
  ],
  "scripts": {
    "build": "unbuild",
    "dev": "unbuild --stub",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:visual": "playwright test tests/e2e/visual/editor-layout-stability.spec.ts --project=chromium",
    "test:render": "playwright test tests/e2e/render-regression.spec.ts --project=chromium",
    "test:perf": "playwright test tests/e2e/performance-regression.spec.ts --project=perf",
    "test:visual:update": "playwright test tests/e2e/visual/editor-layout-stability.spec.ts --project=chromium --update-snapshots",
    "cls:check": "lighthouse-ci --config=./.lighthouserc.json"
  },
  "peerDependencies": {
    "fabric": ">=6.0.0 <7.0.0",
    "vitepress": ">=1.0.0 <2.0.0",
    "vue": ">=3.2.0 <4.0.0"
  },
  "peerDependenciesMeta": {
    "fabric": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.2.0",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.0",
    "fabric": "^6.5.3",
    "happy-dom": "^20.11.2",
    "typescript": "^5.0.0",
    "unbuild": "^2.0.0",
    "vitepress": "^1.6.3",
    "vitest": "^2.0.0",
    "vue": "^3.5.0"
  },
  "dependencies": {
    "dompurify": "^3.2.6"
  }
}
